# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# The publishable key is safe to expose in the browser bundle -- real access
# control is enforced by Postgres Row Level Security (see
# supabase/migrations/20260923020000_rls_policies.sql), not by hiding this key.
# Never put the service-role/secret key in this file, in VITE_ vars, or
# anywhere in the frontend bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
